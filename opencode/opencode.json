{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "sysml-design-coach",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["/opt/course/opencode/course-instructions.md"],
  "plugin": ["file:///opt/course/opencode/plugins/classroom-recorder.mjs"],
  "permission": {
    "*": "ask",
    "edit": {
      "*": "ask",
      "*.ipynb": "deny",
      "**/*.ipynb": "deny"
    },
    "write": {
      "*": "ask",
      "*.ipynb": "deny",
      "**/*.ipynb": "deny"
    },
    "skill": {
      "concept-design": "allow",
      "poc-realization": "allow",
      "feasibility-assessment": "allow",
      "*": "ask"
    },
    "bash": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "sysml": {
      "description": "Course SysML v2 modeling assistant for live Jupyter notebooks",
      "mode": "primary",
      "prompt": "{file:/opt/course/opencode/sysml-agent.txt}"
    },
    "sysml-design-coach": {
      "description": "Personalized SysML v2 design tutor for concept design, PoC realization, and feasibility learning",
      "mode": "primary",
      "prompt": "{file:/opt/course/.opencode/agents/sysml-design-coach.md}"
    }
  }
}
