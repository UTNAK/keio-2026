{
  "name": "@keio/classroom-status",
  "version": "0.1.0",
  "private": true,
  "description": "A small JupyterLab status-bar item for private course evidence and sync state",
  "main": "src/index.js",
  "style": "style/index.css",
  "sideEffects": ["style/index.css"],
  "files": ["src/*", "style/*"],
  "scripts": {
    "build": "build-labextension ."
  },
  "dependencies": {
    "@jupyterlab/application": "~4.6.3",
    "@jupyterlab/apputils": "~4.7.3",
    "@jupyterlab/coreutils": "~6.6.0",
    "@jupyterlab/notebook": "~4.6.3",
    "@jupyterlab/services": "~7.6.0",
    "@jupyterlab/statusbar": "~4.6.3",
    "@lumino/widgets": "~2.6.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.5.11"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "keio_classroom_status/labextension"
  }
}
